# YANA MOTORS OS
# Phase 1 runs on demo data only, so NO secrets are needed to run or deploy it.
#
# Later phases: copy this file to ".env.local", fill in the values, and never commit ".env.local".

# "demo" shows the DEMO banner everywhere. Use "production" only when real integrations are live.
NEXT_PUBLIC_APP_ENV=demo

